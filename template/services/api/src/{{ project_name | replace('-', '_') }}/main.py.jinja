import os
{% if include_persistence %}import sqlite3
from contextlib import closing, contextmanager
from pathlib import Path
{% endif %}
from fastapi import FastAPI
{% if include_persistence %}from pydantic import BaseModel
{% endif %}
app = FastAPI(title="{{ project_name }}")
{% if include_persistence %}

@contextmanager
def connect():
    path = Path(os.environ.get("DATABASE_PATH", "data/app.sqlite3"))
    path.parent.mkdir(parents=True, exist_ok=True)
    with closing(sqlite3.connect(path, timeout=10)) as connection:
        with connection:
            connection.execute(
                "CREATE TABLE IF NOT EXISTS items (key TEXT PRIMARY KEY, value TEXT)"
            )
            yield connection


class Item(BaseModel):
    value: str


@app.put("/items/{key}")
def put_item(key: str, item: Item) -> dict[str, str]:
    with connect() as connection:
        connection.execute(
            "INSERT INTO items VALUES (?, ?) ON CONFLICT(key) DO UPDATE SET value=excluded.value",
            (key, item.value),
        )
    return {"key": key, "value": item.value}


@app.get("/items")
def items() -> dict[str, str]:
    with connect() as connection:
        return dict(connection.execute("SELECT key, value FROM items"))
{% endif %}

@app.get("/live")
def live() -> dict[str, str]:
    return {"status": "ok"}


@app.get("/health")
def health() -> dict[str, str]:
{% if include_persistence %}    with connect() as connection:
        connection.execute("SELECT 1")
{% endif %}    return {"status": "ok"}


def main() -> None:
    import uvicorn

    uvicorn.run(
        "{{ project_name | replace('-', '_') }}.main:app",
        # Intentional network-accessible container listener.
        host="0.0.0.0",  # nosec B104
        port=int(os.environ.get("API_PORT", "{{ api_port }}")),
    )
