[project]
name = "{{ project_name }}-api"
version = "0.1.0"
requires-python = ">=3.12"
dependencies = ["fastapi>=0.115,<1", "uvicorn[standard]>=0.32,<1"]

[build-system]
requires = ["hatchling>=1.26,<2"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ project_name | replace('-', '_') }}"]

[project.scripts]
{{ project_name }} = "{{ project_name | replace('-', '_') }}.main:main"
