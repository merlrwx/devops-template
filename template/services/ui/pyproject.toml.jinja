[project]
name = "{{ project_name }}-ui"
version = "0.1.0"
requires-python = ">=3.12"
dependencies = ["streamlit>=1.40,<2"]

[build-system]
requires = ["hatchling>=1.26,<2"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ project_name | replace('-', '_') }}_ui"]
