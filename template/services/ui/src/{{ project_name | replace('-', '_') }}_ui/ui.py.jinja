import os
from urllib.error import URLError
from urllib.request import urlopen

import streamlit as st

from {{ project_name | replace('-', '_') }}{% if separate_packages %}_ui{% endif %}.ui_utils import health_url

api_url = os.environ.get("API_URL", "http://localhost:{{ api_port }}").rstrip("/")
st.title("{{ project_name }}")
st.write("Project UI")

try:
    # health_url rejects non-HTTP URL schemes.
    with urlopen(health_url(api_url), timeout=2) as response:  # nosec B310
        st.success(f"API status: {response.status}")
except (OSError, URLError) as error:
    st.warning(f"API unavailable: {error}")
