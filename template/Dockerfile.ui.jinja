FROM python:3.14.8-slim
COPY --from=ghcr.io/astral-sh/uv:0.12.22 /uv /usr/local/bin/uv
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml ./
{% if separate_packages %}COPY services ./services
{% else %}COPY src ./src
{% endif %}
# Use a committed lock when available; initial scaffolds resolve once on first build.
COPY . /app
RUN if [ ! -f uv.lock ]; then uv lock; fi \
    && uv sync --locked --no-dev {% if separate_packages %}--package {{ project_name }}-ui{% endif %}
RUN useradd --uid 10001 --create-home app && mkdir -p /app/data && chown app:app /app/data
USER app
EXPOSE {{ ui_port }}
CMD ["uv", "run", "--no-sync", "streamlit", "run", "{% if separate_packages %}services/ui/src/{{ project_name | replace('-', '_') }}_ui{% else %}src/{{ project_name | replace('-', '_') }}{% endif %}/ui.py", "--server.address=0.0.0.0", "--server.port={{ ui_port }}"]
