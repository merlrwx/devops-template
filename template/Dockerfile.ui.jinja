FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src
WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir 'uv>=0.7,<1' \
    && uv sync --no-dev --no-install-project

EXPOSE {{ ui_port }}
CMD ["uv", "run", "--no-sync", "streamlit", "run", "src/{{ project_name | replace('-', '_') }}/ui.py", "--server.address=0.0.0.0", "--server.port={{ ui_port }}"]
