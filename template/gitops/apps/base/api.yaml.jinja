apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ project_name }}-api
spec:
  replicas: 1
{% if include_persistence and 'api' == 'api' %}
  strategy:
    type: Recreate
{% endif %}
  selector:
    matchLabels:
      app: {{ project_name }}-api
  template:
    metadata:
      labels:
        app: {{ project_name }}-api
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        fsGroup: 10001
      containers:
        - name: api
          image: {{ project_name }}-api:local
          ports:
            - name: http
              containerPort: {{ api_port }}
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              memory: 512Mi
          startupProbe:
            httpGet:
              path: /live
              port: http
            failureThreshold: 30
            periodSeconds: 2
          readinessProbe:
            httpGet:
              path: /health
              port: http
          livenessProbe:
            httpGet:
              path: /live
              port: http
{% if include_persistence %}
          env:
            - name: DATABASE_PATH
              value: /app/data/app.sqlite3
          volumeMounts:
            - name: data
              mountPath: /app/data
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: {{ project_name }}-data
{% endif %}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ project_name }}-api
spec:
  selector:
    app: {{ project_name }}-api
  ports:
    - name: http
      port: {{ api_port }}
      targetPort: http
