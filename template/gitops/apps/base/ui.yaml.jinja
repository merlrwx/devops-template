apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ project_name }}-ui
spec:
  replicas: 1
{% if include_persistence and 'ui' == 'api' %}
  strategy:
    type: Recreate
{% endif %}
  selector:
    matchLabels:
      app: {{ project_name }}-ui
  template:
    metadata:
      labels:
        app: {{ project_name }}-ui
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        fsGroup: 10001
      containers:
        - name: ui
          image: {{ project_name }}-ui:local
          ports:
            - name: http
              containerPort: {{ ui_port }}
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              memory: 1Gi
          startupProbe:
            httpGet:
              path: /_stcore/health
              port: http
            failureThreshold: 30
            periodSeconds: 2
          readinessProbe:
            httpGet:
              path: /_stcore/health
              port: http
          livenessProbe:
            httpGet:
              path: /_stcore/health
              port: http
          env:
            - name: API_URL
              value: http://{{ project_name }}-api:{{ api_port }}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ project_name }}-ui
spec:
  selector:
    app: {{ project_name }}-ui
  ports:
    - name: http
      port: {{ ui_port }}
      targetPort: http
