"""Update only matching API/UI image entries; preserve unrelated YAML."""

import argparse
import re
from pathlib import Path


def update(path: Path, tag: str) -> None:
    match = re.fullmatch(r"(?:(api|ui)-)?v[0-9]+\.[0-9]+\.[0-9]+(?:-[A-Za-z0-9.-]+)?", tag)
    if not match:
        raise ValueError("Expected a version release tag")
    component = match.group(1)
    text = path.read_text()
    changed = 0
    for role in ["api"{% if project_type == 'python-api-with-ui' %}, "ui"{% endif %}]:
        if component and role != component:
            continue
        pattern = r"(  - name: {{ project_name }}-" + role + r"\n    newName: [^\n]+\n    newTag: )[^\n]+"
        text, count = re.subn(pattern, lambda m: m.group(1) + tag, text)
        if count != 1:
            raise ValueError(f"Expected exactly one {role} image mapping")
        changed += count
    if not changed:
        raise ValueError("Tag does not identify a configured component")
    path.write_text(text)


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("path", type=Path)
    parser.add_argument("tag")
    args = parser.parse_args()
    update(args.path, args.tag)
