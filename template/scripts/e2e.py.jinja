"""Exercise application services in an owned disposable cluster and clean it up."""

import json
import os
import socket
import subprocess
import tempfile
import time
import uuid
from contextlib import contextmanager
from urllib.error import URLError
from urllib.request import Request, urlopen

from cluster import NAMESPACE, PROJECT, kube, operate


@contextmanager
def service(cluster: str, role: str, port: int):
    with socket.socket() as sock:
        sock.bind(("127.0.0.1", 0))
        local_port = sock.getsockname()[1]
    process = subprocess.Popen(
        [
            "kubectl",
            "--context",
            f"k3d-{cluster}",
            "-n",
            NAMESPACE,
            "port-forward",
            f"service/dev-{PROJECT}-{role}",
            f"{local_port}:{port}",
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    url = f"http://127.0.0.1:{local_port}"
    try:
        health = "/health" if role == "api" else "/_stcore/health"
        for _ in range(60):
            if process.poll() is not None:
                raise RuntimeError("Port forward terminated")
            try:
                with urlopen(url + health, timeout=2) as response:
                    if response.status == 200:
                        break
            except (OSError, URLError):
                time.sleep(1)
        else:
            raise RuntimeError("Service did not become healthy")
        yield url
    finally:
        process.terminate()
        process.wait(timeout=10)


def exercise():
    cluster = PROJECT + "-e2e-" + uuid.uuid4().hex[:8]
    try:
        operate("setup", cluster)
        with service(cluster, "api", {{ api_port }}) as url:
            with urlopen(url + "/live", timeout=5) as response:
                assert json.load(response) == {"status": "ok"}
{% if include_persistence %}            request = Request(
                url + "/items/e2e",
                data=b'{"value":"persisted"}',
                method="PUT",
                headers={"Content-Type": "application/json"},
            )
            with urlopen(request, timeout=5) as response:
                assert response.status == 200
        kube(cluster, "-n", NAMESPACE, "rollout", "restart", f"deployment/dev-{PROJECT}-api")
        kube(
            cluster,
            "-n",
            NAMESPACE,
            "rollout",
            "status",
            f"deployment/dev-{PROJECT}-api",
            "--timeout=180s",
        )
        with service(cluster, "api", {{ api_port }}) as url:
            with urlopen(url + "/items", timeout=5) as response:
                assert json.load(response)["e2e"] == "persisted"
{% endif %}{% if project_type == 'python-api-with-ui' %}
        with service(cluster, "ui", {{ ui_port }}) as url:
            with urlopen(url + "/_stcore/health", timeout=5) as response:
                assert response.status == 200
{% endif %}
        print("Kubernetes E2E passed")
    finally:
        operate("down", cluster, yes=True)


def main():
    previous = os.environ.get("KUBECONFIG")
    with tempfile.TemporaryDirectory(prefix=PROJECT + "-kubeconfig-") as directory:
        os.environ["KUBECONFIG"] = directory + "/config"
        try:
            exercise()
        finally:
            if previous is None:
                os.environ.pop("KUBECONFIG", None)
            else:
                os.environ["KUBECONFIG"] = previous


if __name__ == "__main__":
    main()
