apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: {{ project_name }}
  namespace: flux-system
spec:
  interval: 10m
  path: {% if include_gitops_promotion %}./apps/dev{% else %}./kubernetes/base{% endif %}
  prune: false
  sourceRef:
    kind: GitRepository
    name: {{ project_name }}
