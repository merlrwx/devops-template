def test_items_survive_new_client(tmp_path, monkeypatch):
    monkeypatch.setenv("DATABASE_PATH", str(tmp_path / "app.sqlite3"))
    with TestClient(app) as client:
        assert client.put("/items/example", json={"value": "first"}).status_code == 200
        assert client.put("/items/example", json={"value": "updated"}).status_code == 200
    with TestClient(app) as client:
        assert client.get("/items").json() == {"example": "updated"}
        assert client.put("/items/bad", json={}).status_code == 422{% endif %}
