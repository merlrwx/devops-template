FROM python:3.14.8-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src
WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir 'uv>=0.7,<1' \
    && uv sync --no-dev --no-install-project

EXPOSE {{ api_port }}
CMD ["uv", "run", "--no-sync", "uvicorn", "{{ project_name | replace('-', '_') }}.main:app", "--host", "0.0.0.0", "--port", "{{ api_port }}"]
